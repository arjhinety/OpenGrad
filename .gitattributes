*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
# JSONL records are hashed byte for byte (P-DET-v1's population_sha256, annotation packages, run ledgers),
# so git must never convert their line endings: stored and checked out exactly as written.
*.jsonl -text
# Packaged audit trails (reports/pdet/provenance/) are pinned by SHA-256.
*.tar.gz binary
# Vendored third-party code is pinned by SHA-256 against its upstream bytes (PROVENANCE.json in each
# directory), so it is checked out byte for byte on every platform, never converted to CRLF.
third_party/** -text
