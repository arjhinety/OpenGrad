# OpenGrad Environment Configuration Example
# Copy to .env for local credentials. DO NOT commit .env to version control.

# OpenAI API Key (used strictly for ambiguous DPO preference adjudication)
OPENAI_API_KEY=

# OpenAI Judge Model (default: gpt-4o-mini)
OPENAI_JUDGE_MODEL=gpt-4o-mini

# Hugging Face User Access Token (optional, for gated repository access)
HF_TOKEN=
