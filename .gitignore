__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
.env
.env.*
!.env.example
.cache/
dist/
node_modules/
build/
wandb/
# Experiment run directories. Bulk artifacts (checkpoints, shards, logs, predictions) stay
# out of Git; the canonical record and its ledger are small metadata and are committed, so
# the evidence under reports/ can be validated from a fresh clone.
runs/**
!runs/**/
!runs/**/experiment.json
!runs/**/ledger.jsonl
# Summary evidence. These are KB-scale derived artifacts that carry the numbers reported in
# reports/, so committing them lets a reader verify a claim from a fresh clone instead of
# having to re-run the GPU work. Bulk outputs stay ignored: per-checkpoint predictions.jsonl
# is ~2.5 MB each and the weights are gigabytes.
!runs/**/failure.json
!runs/**/checkpoint_registration_errors.json
# The run's captured environment (engine, library versions, commit). Result freezes pin it as
# evidence, so it must survive a fresh clone like the record it belongs to.
!runs/**/environment.json
# The two cross-experiment authoritative records. Per-run `ledger.jsonl` and `experiment.json` are
# tracked so a record can name its own history; these aggregate exactly that across runs, and the
# checkpoint registry holds lifecycle statuses no per-run file carries. Leaving them untracked
# meant a fresh clone could rebuild `results/registry.jsonl` and see a checkpoint marked REJECTED
# while `opengrad checkpoint list` reported it absent -- two authoritative views disagreeing.
!runs/central_ledger.jsonl
!runs/checkpoint_registry.json
!runs/**/rendering_report.json
!runs/**/overflow_report.json
!runs/**/training_metadata.json
!runs/**/dpo_training_metadata.json
!runs/**/dataset_manifest.json
!runs/**/preference_dataset.json
!runs/**/events.jsonl
!runs/**/resolved_config.yaml
!runs/**/eval/curve.json
!runs/**/eval/checkpoint-*/metrics.json
# Measurements are namespaced by evaluation partition (`eval/dev/`, `eval/confirmatory/`) so a
# checkpoint scored on DEV and on the confirmatory partition cannot overwrite the other. These
# patterns keep the summary artifacts committable at either depth.
!runs/**/eval/*/curve.json
!runs/**/eval/*/checkpoint-*/metrics.json
!runs/**/eval/*/selection--*.json
!runs/**/metrics/*.jsonl
runs/**/predictions.jsonl
runs/**/training_state.pt
runs/**/model.safetensors
runs/**/*.tmp
# Local bulk outputs: the top-level scratch dir and the ~1 GB render/audit index under reports/.
/artifacts/
reports/artifacts/
# Assembled Hugging Face dataset releases. The parquet shards are hundreds of MB and are published
# on the Hub, so they stay out of Git. A release manifest that a result freeze pins as evidence is
# committed, byte-identical to the published copy, so the freeze verifies from a fresh clone.
.release/**
!.release/**/
!.release/hf/toolpolicy-canonical-v2-final/release-manifest.json
/checkpoints/
data/raw/
data/processed/
# Anchored: an unanchored `datasets/` also hid results/benchmarks/datasets/*.meta.json and
# docs/datasets/, which are meant to be committed.
/datasets/
results/raw/
# In-flight atomic write target for the derived experiment index; the index itself is tracked.
results/*.tmp
reports/benchmarks/
openweights/
android-studio/
# Annotation working state (SQLite) and the annotation UI's build outputs. Research output from the
# tool is exported as JSONL packages under reports/ and committed from there.
/.annotation/
# Verbatim subagent transcripts of the P-DET model labels: they carry the session's injected context (an
# e-mail address, local paths), so only their hashes are tracked (reports/pdet/provenance/model-a/).
# One rule for every annotation set, present and future (was one line per set).
reports/**/provenance/*/local/
integrations/annotate-ui/.next/
integrations/annotate-ui/out/
integrations/annotate-ui/next-env.d.ts
integrations/annotate-ui/*.tsbuildinfo
prompt*.txt
*.safetensors
*.gguf
*.bin
*.pth
*.pt
*.ckpt
*.swp
*.swo

# Personal application materials — local only, never publish
docs/research/compute-proposal.md
docs/research/runpod-application-draft.md

# Machine-local agent/MCP registration and personal taste learning.
# Portable config lives in integrations/opengrad-mcp/mcp.example.json.
.mcp.json
.commandcode/taste/

# Dry-run scratch: never evidence.
runs/.dry-run/

# Local agent scratch: session plans, not project artifacts.
.zcode/

# ---------------------------------------------------------------------------
# Benchmark campaign artifacts (capability_v1 and the GGUF study).
#
# Same rule the run directories above already follow: the canonical record is
# committed, the bulk it was derived from is not. Committing everything would
# add ~720 MB, and single files reach 97 MB -- past the point where GitHub
# warns and a clone stays usable.
#
# COMMITTED (KB-scale, carries every number in reports/):
#   *_scores.json, run_summary.json, checkpoint_ladder.json, cost_ledger.json,
#   gpu_runs.jsonl, capability_findings.jsonl, regression_analysis.json,
#   final_campaign_audit.json, refusal_characterization.json,
#   sft_refusal_supervision_audit.json, tokenizer_divergence_census.json,
#   PRESERVED_STATE_v1.json, *_v1.meta.json, results/final_campaign_verdict.json
#
# NOT COMMITTED (regenerable or bulk):
#   request sets  -- rebuilt byte-identically by
#                    scripts/prepare_capability_benchmarks.py from pinned HF
#                    revisions; a test asserts the rebuild reproduces the hash
#   generations   -- raw model output; NOT regenerable without GPU. Held
#                    locally. To publish, upload as a HF dataset rather than
#                    committing it here.
#   per-example   -- derived from generations by the scorers
#   evidence/     -- the joined per-example view, derived from both
# ---------------------------------------------------------------------------
results/benchmarks/datasets/*.jsonl
results/benchmarks/h200/capability_v1/**/generations_*.jsonl
results/benchmarks/h200/capability_v1/**/*_per_example.jsonl
results/benchmarks/h200/capability_v1/evidence/
results/quantization/frozen_prompts_v1.jsonl
results/quantization/frozen_behavioral_eval_v1.jsonl
results/quantization/gguf/predictions_*.json
results/benchmarks/h200/predictions_*.json

# Local agent scratch: a working copy of checkpoints, GGUF builds and session
# state. Never project evidence.
.workspace/
